# Copy to .env.local for local dev (gitignored via the repo's *.local rule).
# In production, set this to your deployed site's own origin + /backend
# (frontend and backend are served from the same host — see backend/README.md)
# and rebuild (`npm run build`) before re-uploading dist/, since Vite bakes
# this in at build time.

# Base URL of the PHP backend, no trailing slash.
VITE_API_URL=http://localhost/backend

# Your WhatsApp Business number in international format, digits only
# (no +, spaces or dashes), e.g. 201012345678 for an Egyptian number.
VITE_WHATSAPP_NUMBER=201012345678
