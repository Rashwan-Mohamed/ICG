# Copy to .env.local for local dev (gitignored via the repo's *.local rule),
# and set these as environment variables in your Vercel project for deploys.

# Base URL of the PHP backend (see backend/README.md), no trailing slash.
VITE_API_URL=http://localhost/backend

# Your WhatsApp Business number in international format, digits only
# (no +, spaces or dashes), e.g. 201012345678 for an Egyptian number.
VITE_WHATSAPP_NUMBER=201012345678
